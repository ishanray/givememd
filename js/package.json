{
  "name": "givememd",
  "version": "0.1.0",
  "description": "Put givememd in front of any URL and get clean, token-lean markdown for LLMs.",
  "type": "module",
  "license": "Apache-2.0",
  "keywords": [
    "markdown",
    "llm",
    "html-to-markdown",
    "web",
    "scraping",
    "mcp",
    "agents"
  ],
  "homepage": "https://givememd.com",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "givememd": "./dist/cli.js",
    "givememd-mcp": "./dist/mcp.js",
    "givememd-server": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/unit.test.mjs test/parity.test.mjs",
    "prepublishOnly": "npm test",
    "test:live": "npm run build && node --test test/live.test.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "css-select": "^7.0.0",
    "domhandler": "^5.0.3",
    "domutils": "^3.2.2",
    "impit": "^0.14.8",
    "parse5": "^8.0.1",
    "parse5-htmlparser2-tree-adapter": "^8.0.1",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "playwright-core": ">=1.40"
  },
  "peerDependenciesMeta": {
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
